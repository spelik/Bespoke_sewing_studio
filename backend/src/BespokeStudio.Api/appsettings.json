{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:5174",
      "http://127.0.0.1:5174",
      "http://localhost:5175",
      "http://127.0.0.1:5175"
    ]
  },
  "Jwt": {
    "Issuer": "BespokeStudio.Api",
    "Audience": "BespokeStudio.Admin",
    "AccessTokenMinutes": 15
  },
  "RefreshToken": {
    "CookieName": "bespoke_admin_refresh",
    "LifetimeDays": 14
  },
  "UploadStorage": {
    "RootPath": "../../storage/uploads",
    "PublicBasePath": "/api/uploads",
    "MaxFileSizeBytes": 5242880,
    "MaxFilesPerRequest": 5,
    "OrphanCleanupAgeMinutes": 120,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "application/pdf"
    ]
  },
  "UploadDeletion": {
    "PollIntervalSeconds": 30,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "BaseRetrySeconds": 30,
    "ProcessingTimeoutMinutes": 5
  },
  "EmailOutbox": {
    "WorkerIntervalSeconds": 30,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "RetryBaseSeconds": 60,
    "RetryMaxMinutes": 60,
    "ProcessingTimeoutMinutes": 5
  },
  "RateLimiting": {
    "PublicUploadPermitLimit": 10,
    "PublicOrderPermitLimit": 5,
    "PublicContactPermitLimit": 5,
    "WindowMinutes": 10,
    "AuthLoginPermitLimit": 10,
    "AuthLoginWindowMinutes": 15,
    "AuthTwoFactorPermitLimit": 10,
    "AuthTwoFactorWindowMinutes": 15
  },
  "SecurityHeaders": {
    "EnableContentSecurityPolicy": true
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "DataProtection": {
    "ApplicationName": "BespokeSewingStudio",
    "KeysPath": ""
  },
  "Notifications": {
    "Email": {
      "Provider": "Logging",
      "Smtp": {
        "Port": 587,
        "FromName": "Bespoke Sewing Studio",
        "UseSsl": true
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UploadSecurity": {
    "MalwareScanner": {
      "Provider": "Disabled",
      "DisplayName": "Not configured",
      "ExecutablePath": "clamscan",
      "Arguments": [
        "--no-summary",
        "{filePath}"
      ],
      "TimeoutSeconds": 30,
      "CleanExitCodes": [
        0
      ],
      "InfectedExitCodes": [
        1
      ],
      "ErrorExitCodes": [
        2
      ],
      "TreatScannerErrorAsRejection": true
    }
  }
}
